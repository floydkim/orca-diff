{
  "name": "orca-diff",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "orca-diff": "bin/orca-diff.ts",
    "orca-review": "bin/orca-diff.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p web",
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "reload": "npm run build && node bin/orca-diff.ts --restart",
    "update": "git pull --ff-only && npm ci && npm run reload"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "monaco-editor": "^0.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "zustand": "^5.1.0"
  }
}
